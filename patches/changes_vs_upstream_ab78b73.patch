 logger = logging.getLogger(__name__)
 
 
@@ -250,3 +255,55 @@ def write_rollout_summaries_jsonl_from_groups(
         taglist_P=[group.tags for group in groups_P],
         sampling_client_steps_P=[group.sampling_client_step for group in groups_P],
     )
+
+
+_LOGTREE_EXPLANATION = (
+    "This HTML log was generated by logtree during training. "
+    "It shows rollouts and rewards for a subset of trajectory groups in this iteration. "
+    "To customize what gets logged, modify the logtree calls in your Env implementation "
+    "(see examples in tinker_cookbook/recipes/)."
+)
+
+
+@contextmanager
+def logtree_scope(
+    output_dir: Path | None,
+    num_groups_to_log: int,
+    f_name: str,
+    scope_name: str,
+    iteration: int,
+    store: "TrainingRunStore | None",
+) -> Iterator[None]:
+    """Context manager that logs rollout data to HTML and JSON via logtree.
+
+    Creates ``output_dir/f_name.html`` (direct I/O — visualization artifact)
+    and writes the logtree JSON via ``store.write_logtree()`` when store is available.
+
+    Rollouts only appear in the output if they were produced with logging
+    enabled (see ``enable_logging`` on the rollout helpers); this scope is what
+    gives those logtree calls somewhere to land.
+
+    Args:
+        output_dir (Path | None): Iteration directory for the HTML file.
+            ``None`` disables logging entirely.
+        num_groups_to_log (int): Number of groups the caller intends to log.
+            Values ``<= 0`` disable logging entirely.
+        f_name (str): Base filename, without extension.
+        scope_name (str): Human-readable name for the root logtree scope.
+        iteration (int): Training iteration / batch index.
+        store (TrainingRunStore | None): Store used to write the logtree JSON.
+    """
+    if output_dir is None or num_groups_to_log <= 0:
+        yield
+        return
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    logtree_path = str(output_dir / f"{f_name}.html")
+    logtree_trace = None
+    try:
+        with logtree.init_trace(scope_name, path=logtree_path) as logtree_trace:
+            logtree.log_text(_LOGTREE_EXPLANATION)
+            yield
+    finally:
+        if logtree_trace is not None and store is not None:
+            store.write_logtree(iteration, logtree_trace.to_dict(), base_name=f_name)
